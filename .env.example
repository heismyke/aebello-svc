# Copy to .env for local development. In production, set these as real
# environment variables (DigitalOcean App Platform: Settings > Environment Variables).

# eSIM Access > Developer > Access Code (required)
ESIM_ACCESS_CODE=

# Send paid orders to eSIM Access. There is no sandbox, so this spends real
# balance. Leave false until you are ready to sell.
ESIM_ORDERING_ENABLED=false

# Paystack > Settings > API Keys. Checkout is switched off while empty.
PAYSTACK_SECRET_KEY=

# Prices are shown in USD. Paystack collects this currency instead, converted
# at the daily rate (open.er-api.com) plus FX_BUFFER (0.03 = 3%).
# CHARGE_CURRENCY=NGN
# FX_BUFFER=0.03
# FX_FALLBACK_RATE=1300

# Postgres. Defaults to the docker compose database.
# DATABASE_URL=postgres://aebello:aebello@localhost:5460/aebello?sslmode=disable

# Public web app; payment redirects return here and it is allowed by CORS.
WEB_URL=http://localhost:5173
# Extra browser origins allowed to call the API, comma separated.
# ALLOWED_ORIGINS=https://aebello.vercel.app

# PORT=8080
# PRICING_FILE=pricing.json
# CATALOG_REFRESH=6h
